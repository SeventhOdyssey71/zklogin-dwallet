# ══════════════════════════════════════════════════════════════════════════════
#  MAINNET. Every key configured here controls real assets on real networks.
# ══════════════════════════════════════════════════════════════════════════════

# ── Google OAuth (OpenID Connect) ───────────────────────────────────────────
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3002/api/zklogin/callback

# ── Shinami zkLogin (salt/address + prover) ──────────────────────────────────
# One key, works on both the zkLogin Wallet and zkProver services.
# IMPORTANT: this must be a MAINNET Shinami key. A testnet key derives a different
# salt — and therefore a different Sui address — for the same Google account.
# Get it at https://app.shinami.com (enable zkLogin Wallet + zkProver).
SHINAMI_API_KEY=

# ── Session cookie encryption ────────────────────────────────────────────────
# Any random 32+ character string. Rotating it logs everyone out.
SESSION_SECRET=

# ── Sui network ──────────────────────────────────────────────────────────────
# The app is mainnet-only; there is no network switch. Override the RPC if you
# have a private endpoint — the public fullnode rate-limits under load.
# NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# ── Ika (2PC-MPC v4) ─────────────────────────────────────────────────────────
# Package and object IDs are NOT configured here. They come from the SDK via
# getNetworkConfig('mainnet') in lib/config/network.ts, so they stay in lockstep
# with @ika.xyz/sdk instead of drifting in an env file.
#
# Mainnet needs real IKA to pay 2PC-MPC session fees (no faucet) and real SUI for gas.

# ── Destination chain RPCs (all optional) ────────────────────────────────────
# Defaults are public endpoints and will rate-limit. Set these for production.
# NEXT_PUBLIC_ETHEREUM_RPC_URL=
# NEXT_PUBLIC_POLYGON_RPC_URL=
# NEXT_PUBLIC_AVALANCHE_RPC_URL=
# NEXT_PUBLIC_BSC_RPC_URL=
# NEXT_PUBLIC_BITCOIN_API_URL=https://blockstream.info/api
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_POLKADOT_RPC_URL=wss://polkadot-asset-hub-rpc.polkadot.io
# NEXT_PUBLIC_CARDANO_API_URL=https://api.koios.rest/api/v1
# NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.mainnet.near.org
